---
import ThemeToggle from '../components/ThemeToggle.tsx';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'Ankit — writing, projects, and small experiments.' } = Astro.props;
const fullTitle = title ? `${title} · ankit.md` : 'ankit.md';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-G3FL5BBC06"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-G3FL5BBC06');
    </script>
    <!-- Apply theme before paint to avoid a flash. -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = saved ?? (prefersDark ? 'dark' : 'light');
        } catch {}
      })();
    </script>
  </head>
  <body>
    <div class="wrap">
      <header class="site-header">
        <a href="/" class="wordmark" aria-label="Ankit — home">
          <span class="wordmark-letter" aria-hidden="true">a</span>
          <span class="wordmark-dot" aria-hidden="true"></span>
        </a>
        <div class="nav-row">
          <nav class="nav">
            <a href="/writing" aria-current={isActive('/writing') ? 'page' : undefined}>writing</a>
            <a href="/projects" aria-current={isActive('/projects') ? 'page' : undefined}>projects</a>
            <a href="/about" aria-current={isActive('/about') ? 'page' : undefined}>about</a>
          </nav>
          <ThemeToggle client:load />
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <span>© {new Date().getFullYear()} Ankit</span>
        <span>built in the open · <a href="https://github.com/nnnkit">github</a></span>
      </footer>
    </div>
  </body>
</html>
