---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const writing = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<Base>
  {writing.length > 0 && (
    <section class="section-block reveal reveal-1" aria-labelledby="latest-writing">
      <div class="section-title-row">
        <p class="section-label" id="latest-writing">Latest writing</p>
        <a class="section-link" href="/writing">All writing</a>
      </div>
      <ul class="entries">
        {writing.map((post) => (
          <li>
            <a class="entry" href={`/writing/${post.id}`}>
              <span class="entry-head">
                <span class="entry-title">{post.data.title}</span>
                <span class="entry-date">{fmt(post.data.date)}</span>
              </span>
              {post.data.description && <p class="entry-desc">{post.data.description}</p>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {projects.length > 0 && (
    <section class="section-block reveal reveal-2" aria-labelledby="selected-projects">
      <div class="section-title-row">
        <p class="section-label" id="selected-projects">Selected projects</p>
        <a class="section-link" href="/projects">All projects</a>
      </div>
      <ul class="entries">
        {projects.map((p) => (
          <li>
            <a class="entry" href={`/projects/${p.id}`}>
              <span class="entry-head">
                <span class="entry-title">{p.data.title}</span>
                <span class="entry-date">{p.data.status}</span>
              </span>
              <p class="entry-desc">{p.data.summary}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
