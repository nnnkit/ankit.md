---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base title="Writing" description="Essays, notes, and explorations by Ankit.">
  <section style="margin-top: 3.5rem;">
    <h1>Writing</h1>
    <p class="lede">Essays, notes, and the occasional thinking-out-loud.</p>
  </section>

  <ul class="entries" style="margin-top: 2rem;">
    {posts.map((post) => (
      <li>
        <a class="entry" href={`/writing/${post.id}`}>
          <span class="entry-head">
            <span class="entry-title">{post.data.title}</span>
            <span class="entry-date">{fmt(post.data.date)}</span>
          </span>
          {post.data.description && <p class="entry-desc">{post.data.description}</p>}
        </a>
      </li>
    ))}
  </ul>

  {posts.length === 0 && <p class="lede" style="margin-top:2rem;">Nothing here yet — soon.</p>}
</Base>
