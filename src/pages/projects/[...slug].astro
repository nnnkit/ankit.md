---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={project.data.title} description={project.data.summary}>
  <article style="margin-top: 3.5rem;">
    <h1>{project.data.title} <span class="tag">{project.data.status}</span></h1>
    <p class="post-meta">
      {fmt(project.data.date)}
      {project.data.url && (
        <>
          {' · '}
          <a href={project.data.url} target="_blank" rel="noopener">visit ↗</a>
        </>
      )}
    </p>
    <div class="prose">
      <Content />
    </div>
  </article>
  <a class="back" href="/projects">← all projects</a>
</Base>
