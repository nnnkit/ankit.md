---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base title="Projects" description="Small things Ankit has built.">
  <section style="margin-top: 3.5rem;">
    <h1>Projects</h1>
    <p class="lede">Small experiments and tools — some live, some still cooking.</p>
  </section>

  <ul class="entries" style="margin-top: 2rem;">
    {projects.map((p) => (
      <li>
        <a class="entry" href={`/projects/${p.id}`}>
          <span class="entry-head">
            <span class="entry-title">
              {p.data.title} <span class="tag">{p.data.status}</span>
            </span>
          </span>
          <p class="entry-desc">{p.data.summary}</p>
        </a>
      </li>
    ))}
  </ul>

  {projects.length === 0 && <p class="lede" style="margin-top:2rem;">Nothing here yet — soon.</p>}
</Base>
